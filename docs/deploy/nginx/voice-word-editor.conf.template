# Front door for the voice-word-editor portal on a reverse-proxy host.
# TEMPLATE — placeholders below must be filled in before this is usable.
# DEFAULT = LAN/VPN-only until you explicitly decide to expose this
# publicly, and only once the default admin/admin credential has been
# changed (see docs/admin-credentials.md — required before public
# exposure in any case).

# <<<DOMAIN_PLACEHOLDER>>>        e.g. voice-editor.example.com — your own domain
# <<<UPSTREAM_HOST_PLACEHOLDER>>> the portal backend's LAN/Tailscale address — NOT YET KNOWN (depends on which
#                                  host actually runs portal-queue's server; see deployment-notes.md)
# <<<UPSTREAM_PORT_PLACEHOLDER>>> the portal backend's listening port — NOT YET DECIDED by portal-queue

server {
    listen 80;
    listen [::]:80;
    server_name <<<DOMAIN_PLACEHOLDER>>>;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name <<<DOMAIN_PLACEHOLDER>>>;

    ssl_certificate     /etc/letsencrypt/live/<<<DOMAIN_PLACEHOLDER>>>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<<<DOMAIN_PLACEHOLDER>>>/privkey.pem;

    # LAN/VPN-only by default. Remove the allow/deny block below ONLY after
    # explicit sign-off for public exposure, and only once the default
    # admin/admin credential has been changed (see docs/admin-credentials.md).
    allow <<<YOUR_LAN_OR_VPN_CIDR_PLACEHOLDER>>>;
    allow 127.0.0.1;
    deny  all;

    client_max_body_size 500m;          # video uploads (30-45s clips, but keep headroom)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # Never log request bodies/headers that could carry credentials or
    # session tokens — keep the default nginx access log format (no
    # $request_body, no Authorization header logging).

    location / {
        proxy_pass http://<<<UPSTREAM_HOST_PLACEHOLDER>>>:<<<UPSTREAM_PORT_PLACEHOLDER>>>;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_send_timeout    300s;       # large uploads/downloads
        proxy_read_timeout    300s;
        proxy_request_buffering off;
    }
}

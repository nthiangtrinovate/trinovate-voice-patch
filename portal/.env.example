# Copy to .env (gitignored) for local dev, or export these as real env
# vars in deployment. NEVER commit a real .env file.

# Admin login seed password (only used the very first time the admin
# account is created; default is "admin" if unset, matching PLAN.md's
# required local-dev default). Changing this does NOT change an
# already-seeded account's password — use the in-app "change password"
# flow for that.
# PORTAL_DEFAULT_ADMIN_PASSWORD=admin

# Worker bearer token (separate credential from admin login). If unset in
# dev, the server generates one at startup and writes it ONLY to
# portal/data/dev_worker_token.txt (mode 0600, gitignored) — never printed
# to stdout/stderr or logged. Set this explicitly (same value on server +
# worker) for anything beyond a single local dev session.
# PORTAL_WORKER_TOKEN=replace-with-a-long-random-string

# Set to "1" to mark this as heading toward a public deployment. At
# startup the server will then refuse to boot if the default admin
# password has not been changed yet. Leave unset for local dev.
# PORTAL_PUBLIC_DEPLOYMENT=1

# Where uploads/outputs/the sqlite DB live. Defaults to ./data next to
# this app if unset.
# PORTAL_DATA_DIR=/path/to/data

# Upload/validation tuning (defaults shown):
# PORTAL_MAX_UPLOAD_BYTES=262144000
# PORTAL_MIN_DURATION_SEC=20
# PORTAL_MAX_DURATION_SEC=60

# How long a worker's claim on a job is honored before another poll may
# reclaim it as stalled (default 300s). Sized against the real worker's
# measured ~82s cold STT load+inference on a ~22s clip; see the comment
# above JOB_CLAIM_LEASE_SECONDS in app/config.py before lowering this.
# PORTAL_JOB_LEASE_SECONDS=300
